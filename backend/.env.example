# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service-role key — server-side only, never ship this to the Electron client
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Where the client should be redirected back to after Stripe Checkout
CLIENT_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
CLIENT_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel

PORT=3000
