# Supabase project settings (Project Settings > API) — anon key only,
# safe to ship in the client since it's constrained by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# BARUDA backend (backend/) base URL, used to start Stripe Checkout.
VITE_BACKEND_URL=http://localhost:3000

# Dev-only: skip real Supabase login and pretend the subscription is
# active, so you can exercise the whole app without a Supabase/Stripe
# account. Has no effect in production builds (import.meta.env.DEV gate).
VITE_MOCK_AUTH=true
